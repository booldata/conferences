	column Category = ```
			
			VAR _custom = CUSTOMDATA()
			VAR _upn = IF ( _custom = BLANK() || _custom = "", USERPRINCIPALNAME(), _custom )
			VAR _availableInfo = 
			    LOOKUPVALUE(
			      'Product Sensible Information'[DepartmentName]
			      ,'Product Sensible Information'[UserPrincipalName]
			      ,_upn
			    )
			RETURN
			    IF(
			        ISBLANK(_availableInfo) || PATHCONTAINS(_availableInfo, [DepartmentName]),
			        SWITCH(
			            USERCULTURE(),
			            "en-US",[CategoryName],
			            "fr-FR",[CategoryName-FR],
			            "pt-PT",[CategoryName-PT],
			            [CategoryName]
			        ),
			        SWITCH(
			            USERCULTURE(),
			            "en-US","Others",
			            "fr-FR","Autres",
			            "pt-PT","Outros",
			            "Others"
			        )    
			    )
			```
		lineageTag: 70390ffb-0810-4433-9cf2-1f67790f5cca
		summarizeBy: none
		expressionContext: userContext

		annotation SummarizationSetBy = Automatic

