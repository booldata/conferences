		annotation PBI_FormatHint = {"isDecimal":true}

	measure Costs = ```
			
			    SUM(Sales[Cost Amount])
			```
		displayFolder: Sales Report
		lineageTag: 6dac3b46-cd6e-4545-b1cf-a5fbf614c685

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Margin = ```
			
			    [Sales]-[Costs]
			```
		displayFolder: Sales Report
