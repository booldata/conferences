	column Country =
			
			SWITCH(
			    USERCULTURE(),
			    "en-US",[CountryName],
			    "pt-PT",[CountryName-PT],
			    "fr-FR",[CountryName-FR],
			    [CountryName]
			)
		lineageTag: 657f0628-84fb-48dd-a756-da13b786808c
		summarizeBy: none
		expressionContext: userContext

		annotation SummarizationSetBy = Automatic

	column Evaluation =
			
			REPT(
			    "★",
			    LOOKUPVALUE(
			      'Store Sensible Information'[Evaluation]
			      ,'Store Sensible Information'[StoreKey]
			      ,Store[StoreKey]
			    )
			)
		lineageTag: 75bbdc98-162a-41d5-9060-7d3d99200cbe
		summarizeBy: none
		expressionContext: userContext

		annotation SummarizationSetBy = Automatic

	column 'Evaluation Value' =
			
			LOOKUPVALUE(
