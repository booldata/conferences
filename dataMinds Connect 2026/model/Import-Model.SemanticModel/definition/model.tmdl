model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup DIM

	annotation PBI_QueryGroupOrder = 0

queryGroup FCT

	annotation PBI_QueryGroupOrder = 1

queryGroup SEC

	annotation PBI_QueryGroupOrder = 2

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Customer","Order Date","Product","Product Sensible Information","Sales","Store","Store Sensible Information","Delivery Date"]

annotation PBI_ProTooling = ["DevMode","TMDLView_Desktop","DaxQueryView_Desktop"]

annotation __TEdtr = 1

ref table Customer
ref table 'Order Date'
ref table Product
ref table 'Product Sensible Information'
ref table Sales
ref table Store
ref table 'Store Sensible Information'
ref table 'Delivery Date'
ref table Indicators

ref role 'Show Everything'
ref role 'Hide Sensible Info'

ref cultureInfo en-US
ref cultureInfo pt-PT
ref cultureInfo fr-FR

